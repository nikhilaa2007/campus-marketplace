PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus-marketplace
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Only emails ending with this domain can register (example: college.edu).
# Leave empty to allow any email while testing.
ALLOWED_EMAIL_DOMAIN=

# SMTP (optional while developing). If SMTP_HOST is empty, the OTP is printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Campus Marketplace <no-reply@campus.local>"

# Cloudinary (cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
